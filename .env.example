# ===== imageAI 大模型接入配置（复制为 .env 并填写）=====

# --- OpenAI 官方 ---
# IMAGEAI_API_KEY=sk-xxxxxx
# IMAGEAI_BASE_URL=https://api.openai.com/v1
# IMAGEAI_MODEL=gpt-4o
# IMAGEAI_IMAGE_MODEL=dall-e-3

# --- DeepSeek ---
# IMAGEAI_API_KEY=sk-xxxxxx
# IMAGEAI_BASE_URL=https://api.deepseek.com/v1
# IMAGEAI_MODEL=deepseek-chat

# --- 月之暗面 Kimi ---
# IMAGEAI_API_KEY=sk-xxxxxx
# IMAGEAI_BASE_URL=https://api.moonshot.cn/v1
# IMAGEAI_MODEL=moonshot-v1-8k

# --- 阿里通义千问（OpenAI 兼容模式）---
# IMAGEAI_API_KEY=sk-xxxxxx
# IMAGEAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# IMAGEAI_MODEL=qwen-plus

# --- 智谱 GLM ---
# IMAGEAI_API_KEY=xxxxxxxx
# IMAGEAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# IMAGEAI_MODEL=glm-4-plus

# --- 本地模型（Ollama / vLLM / LM Studio 等，无需 Key）---
# IMAGEAI_API_KEY=ollama
# IMAGEAI_BASE_URL=http://localhost:11434/v1
# IMAGEAI_MODEL=qwen2.5:14b
